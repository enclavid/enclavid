package enclavid:host@0.1.0;

/// Lookup interface for disclosure fields by their key — machine identifiers
/// that surface as `display-field.key` on the consent screen
/// (`action::render(prompt::consent-disclosure)`); the consumer SDK dispatches
/// the field by literal key. A plugin's helpers name a field of the policy's
/// list through it; the policy declares that list itself, as the cases of
/// `key` in `enclavid:host-ext/disclosure-fields`. Resolves MERGED
/// first-match across the whole composition: the covert-channel bound is the
/// static disclosure-field-set size the applicant sees on the consent screen.
/// A reserved host capability, resolved against the composition's
/// `enclavid:embedded.disclosure-fields.v1` sections.
interface embedded-disclosure-fields {
    /// Ref RESOURCE in the shared `types` interface, with the other refs.
    use types.{disclosure-field-ref};

    /// Resolve a key from the composition's disclosure fields. Traps if the
    /// key isn't declared in any catalog.
    disclosure-field: func(key: string) -> disclosure-field-ref;
}
