package enclavid:host-capture@0.1.0;

/// A video step, and what it asks the applicant to do.
interface video {
    use enclavid:host/refs@0.1.0.{localized-ref};
    use photo.{shape};

    /// A shape in a video, which the page does not read: the applicant says
    /// with a button they have followed it.
    record shape-guide {
        shape: shape,
        /// What the applicant lines up with it, shown on camera while it is
        /// held ("The photo page of your passport"): a text of the component's
        /// `i18n` catalog.
        label: localized-ref,
        /// How long it is held after the button, in milliseconds; held to
        /// 5000.
        hold-ms: u16,
    }

    /// A face the page finds at the centre of the frame, at a size. The page
    /// draws an oval for it, as wide for its height as
    /// `constants.oval-aspect` says.
    record face-guide {
        /// The face's width as a fraction of the frame's shorter side; held to
        /// 0.25–0.6: smaller, the page does not find a face reliably; larger,
        /// the oval no longer fits.
        width: f32,
        /// How long the face stays there, in milliseconds; held to 5000.
        hold-ms: u16,
        /// The longest break in the hold the page forgives, in milliseconds;
        /// held to 1000.
        grace-ms: u16,
    }

    /// A turn of the head the page reads.
    record head-turn-guide {
        /// How far, negative to the applicant's left; held to ±45. A turn of
        /// none is refused.
        degrees: s8,
        /// How long it is held, in milliseconds; held to 5000.
        hold-ms: u16,
        /// The longest break in the hold the page forgives, in milliseconds;
        /// held to 1000.
        grace-ms: u16,
    }

    /// A colour on screen, by its red, green and blue, as `#rrggbb` writes
    /// them.
    record color {
        red: u8,
        green: u8,
        blue: u8,
    }

    /// A face the page finds at the centre of the frame, at a size, held there
    /// while the screen lights it: around the oval the page draws for it, as
    /// for a `face`, the screen shows each colour in turn. The flashes begin
    /// once the face has been in the oval for a moment, or at once where a
    /// `face` or flashes guide before them held it there, and start over if
    /// the face leaves for longer than `grace-ms`.
    record face-flashes-guide {
        /// The face's width as a fraction of the frame's shorter side; held to
        /// 0.25–0.6, as a `face`'s is.
        width: f32,
        /// The colours, in the order shown; 1 to 16 of them.
        colors: list<color>,
        /// How long each colour is shown, in milliseconds; held to 250–1000.
        flash-ms: u16,
        /// The longest break in the flashes the page forgives, in
        /// milliseconds; held to 1000.
        grace-ms: u16,
    }

    /// One thing a video asks the applicant to do. Each is held before the
    /// next is shown: a shape from the applicant's button; a face, with its
    /// flashes or without, and a head turn from when the page reads them in
    /// the frames.
    variant guide {
        shape(shape-guide),
        face(face-guide),
        head-turn(head-turn-guide),
        face-flashes(face-flashes-guide),
    }

    /// A video, sent with no review screen.
    record video-spec {
        /// What it asks, in order, each held for its `hold-ms` or through all
        /// its flashes — for one frame where that is 0 — before the next. The
        /// reply says where each was held.
        guides: list<guide>,
    }
}
