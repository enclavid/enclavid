package enclavid-ext:extra@0.1.0;

/// The plugin's texts; `i18n/en.json` holds them. Kept out of `wit/` and
/// vendored into `wit/deps` by `wkg`, which reads a package it does not
/// find in a registry only from a path.
interface i18n {
    use enclavid:host/types@0.1.0.{localized-ref};
    enum key { extra-tag }
    localized: func(key: key) -> localized-ref;
}
