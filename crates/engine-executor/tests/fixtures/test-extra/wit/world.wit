package enclavid:extra@0.1.0;

/// Minimal second plugin for the hybrid composition test. Its single
/// export is one of its OWN texts, through the slot its own catalog
/// names.
interface tag {
    use enclavid:host/types@0.1.0.{localized-ref};
    get: func() -> localized-ref;
}

/// The plugin's texts; `i18n/en.json` holds them.
interface i18n {
    use enclavid:host/types@0.1.0.{localized-ref};
    enum key { extra-tag }
    localized: func(key: key) -> localized-ref;
}

world plugin {
    import i18n;
    export tag;
}
