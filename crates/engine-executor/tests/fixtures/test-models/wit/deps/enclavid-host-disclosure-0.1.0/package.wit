package enclavid:host-disclosure@0.1.0;

/// Disclosure-flow shape — `display-field`, a consented (key, label,
/// value) triple. Used by the `enclavid:policy` contract
/// (`action::render(prompt::consent-disclosure)` + `event::consent-disclosure`).
interface disclosure {
  use enclavid:host/refs@0.1.0.{disclosure-field-key-ref, disclosure-field-value-ref, localized-ref};

  /// One consented field surfaced on the applicant's consent
  /// screen and (modulo the label) included in the sealed
  /// disclosure envelope to the consumer.
  record display-field {
    /// A ref the host mints, which no component can construct
    /// (closing the runtime ref-crafting channel) — minted by the
    /// policy's `enclavid-ext:policy/disclosure-fields.disclosure-field`,
    /// from a case of its `key`: the policy's list, the one a
    /// composition has. A plugin's helper that builds a
    /// `display-field` takes the ref the policy minted. The host
    /// **always shows the machine key raw** on the consent screen
    /// — no canonical/custom distinction, every (key, label,
    /// value) triple is rendered with nothing suppressed. The user
    /// is the sole auditor on this screen; whatever string leaves
    /// is whatever they saw next to the slide-to-disclose.
    /// Defence against a policy that tries to encode categorical
    /// data (country, gender, bucket id, ...) into key
    /// cardinality: the list is the policy's WIT, frozen before
    /// any per-session input reaches the policy, so a fresh
    /// `passport-number-<user-country>` can't be minted at
    /// evaluate time.
    key: disclosure-field-key-ref,
    /// A ref the host mints, which no component can construct
    /// (closing the runtime ref-crafting channel) — minted by a
    /// slot's `enclavid-ext:<slot>/i18n.localized`. The host resolves
    /// it from the slot's catalog into the full set of language
    /// translations; the frontend picks the user's locale.
    /// Resolved label is sent to the frontend **only** — it never
    /// reaches the sealed envelope, closing any covert translation
    /// channel where non-user-locale variants might otherwise
    /// smuggle data to the consumer.
    label: localized-ref,
    /// A ref the host mints, which no component can construct —
    /// minted by a function of `values` for its kind, so a new kind
    /// comes as a new function there and this record stays as it is.
    value: disclosure-field-value-ref,
  }
}

/// The values a disclosure field shows and, on accept, seals: a function for
/// each kind.
interface values {
  use enclavid:host/refs@0.1.0.{disclosure-field-value-ref};

  /// A text, as the policy writes it. Sanitised host-side (control chars,
  /// BIDI overrides, zero-width and Unicode-tag chars stripped) and held to
  /// 4096 bytes; its format is the policy's call.
  text: func(value: string) -> disclosure-field-value-ref;
}

