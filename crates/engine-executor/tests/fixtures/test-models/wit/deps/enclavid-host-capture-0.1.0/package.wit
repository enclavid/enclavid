package enclavid:host-capture@0.1.0;

/// The numbers the page draws guides by, which the host serves.
interface constants {
  /// The width over the height of every oval the page draws: an `oval`
  /// guide's, and the one around the face of a `face` or `face-flashes`
  /// guide.
  oval-aspect: func() -> f32;
}

/// A photo step, and the shapes drawn over the camera, which a video shows
/// too.
interface photo {
  use enclavid:host/refs@0.1.0.{localized-ref};

  /// A rectangle at the centre of the frame, as large as fits.
  record rect-shape {
    /// Its width:height aspect, held to 0.5–2.0 (1.42 passport, 1.585
    /// ID-1).
    aspect: f32,
  }

  /// An oval at the centre of the frame, as wide for its height as
  /// `constants.oval-aspect` says.
  record oval-shape {
    /// As a fraction of the frame's shorter side, so the oval keeps its
    /// size on a frame of either orientation; held to 0.1–0.6, where its
    /// height still fits that side.
    width: f32,
  }

  /// A shape drawn over the camera. Every guide's numbers are held to their
  /// ranges where the prompt is built: past those, a guide no longer fits
  /// the screen or a face.
  variant shape {
    rect(rect-shape),
    oval(oval-shape),
  }

  /// A shape the page does not read: the applicant fits into it whatever
  /// they are asked to, and says with the shutter when they have.
  record shape-guide {
    shape: shape,
    /// What the applicant fits into it, shown on camera ("The photo page
    /// of your passport"): a text of the component's `i18n` catalog.
    label: localized-ref,
  }

  /// A face the page finds at the centre of the frame, at a size, in the
  /// oval it draws for it, as wide for its height as
  /// `constants.oval-aspect` says. The page takes the photo once the face
  /// fills the oval.
  record face-guide {
    /// The face's width as a fraction of the frame's shorter side; held to
    /// 0.25–0.6: smaller, the page does not find a face reliably; larger,
    /// the oval no longer fits.
    width: f32,
  }

  /// What a photo's camera shows, and what takes the photo: the shutter for
  /// a shape, the page for a face it reads.
  variant guide {
    shape(shape-guide),
    face(face-guide),
  }

  /// A photo: one frame.
  record photo-spec {
    /// What the camera shows, if anything; none: nothing drawn, and the
    /// shutter takes the photo.
    guide: option<guide>,
    /// The check shown under the photo on the review screen, where the
    /// applicant keeps it or takes it again ("Make sure the MRZ is sharp
    /// and free of glare"); none: no review screen, the photo is sent as
    /// taken.
    review-hint: option<localized-ref>,
  }
}

/// A video step, and what it asks the applicant to do.
interface video {
  use enclavid:host/refs@0.1.0.{localized-ref};
  use photo.{shape};

  /// A shape in a video, which the page does not read: the applicant says
  /// with a button they have followed it.
  record shape-guide {
    shape: shape,
    /// What the applicant lines up with it, shown on camera while it is
    /// held ("The photo page of your passport"): a text of the component's
    /// `i18n` catalog.
    label: localized-ref,
    /// How long it is held after the button, in milliseconds; held to
    /// 5000.
    hold-ms: u16,
  }

  /// A face the page finds at the centre of the frame, at a size. The page
  /// draws an oval for it, as wide for its height as
  /// `constants.oval-aspect` says.
  record face-guide {
    /// The face's width as a fraction of the frame's shorter side; held to
    /// 0.25–0.6: smaller, the page does not find a face reliably; larger,
    /// the oval no longer fits.
    width: f32,
    /// How long the face stays there, in milliseconds; held to 5000.
    hold-ms: u16,
    /// The longest break in the hold the page forgives, in milliseconds;
    /// held to 1000.
    grace-ms: u16,
  }

  /// A turn of the head the page reads.
  record head-turn-guide {
    /// How far, negative to the applicant's left; held to ±45. A turn of
    /// none is refused.
    degrees: s8,
    /// How long it is held, in milliseconds; held to 5000.
    hold-ms: u16,
    /// The longest break in the hold the page forgives, in milliseconds;
    /// held to 1000.
    grace-ms: u16,
  }

  /// A colour on screen, by its red, green and blue, as `#rrggbb` writes
  /// them.
  record rgb {
    red: u8,
    green: u8,
    blue: u8,
  }

  /// A face the page finds at the centre of the frame, at a size, held there
  /// while the screen lights it: around the oval the page draws for it, as
  /// for a `face`, the screen shows each colour in turn. The flashes begin
  /// once the face has been in the oval for a moment, or at once where a
  /// `face` or flashes guide before them held it there, and start over if
  /// the face leaves for longer than `grace-ms`.
  record face-flashes-guide {
    /// The face's width as a fraction of the frame's shorter side; held to
    /// 0.25–0.6, as a `face`'s is.
    width: f32,
    /// The colours, in the order shown; 1 to 16 of them.
    colors: list<rgb>,
    /// How long each colour is shown, in milliseconds; held to 250–1000.
    flash-ms: u16,
    /// The longest break in the flashes the page forgives, in
    /// milliseconds; held to 1000.
    grace-ms: u16,
  }

  /// One thing a video asks the applicant to do. Each is held before the
  /// next is shown: a shape from the applicant's button; a face, with its
  /// flashes or without, and a head turn from when the page reads them in
  /// the frames.
  variant guide {
    shape(shape-guide),
    face(face-guide),
    head-turn(head-turn-guide),
    face-flashes(face-flashes-guide),
  }

  /// A video, sent with no review screen.
  record video-spec {
    /// What it asks, in order, each held for its `hold-ms` or through all
    /// its flashes — for one frame where that is 0 — before the next. The
    /// reply says where each was held.
    guides: list<guide>,
  }
}

/// Capture-flow shapes — `media-spec` / `capture-step` and friends. Pure
/// value types used by the `enclavid:policy` contract
/// (`action::render(prompt::media)` + `event::media`) and helper plugins
/// (e.g. `enclavid:well-known`). The host capabilities that mint the refs
/// these records carry live in `enclavid:host`.
interface capture {
  use enclavid:host/refs@0.1.0.{localized-ref, icon-ref};
  use photo.{photo-spec};
  use video.{video-spec};

  /// Which physical camera the capture step should use.
  enum camera-facing {
    /// The one facing the applicant, for a selfie.
    front,
    /// The one facing away, for documents.
    rear,
    /// The browser picks; useful for laptops without a rear lens.
    any,
  }

  /// What one capture step records.
  variant capture-kind {
    /// One frame, which the applicant keeps.
    photo(photo-spec),
    /// A video, recorded while guides are shown.
    video(video-spec),
  }

  /// One step within a capture. For two-sided documents: front + back. For
  /// multi-page documents: one step per page. Single-shot captures
  /// (passport photo page, selfie) use a single step. The steps of ONE media
  /// render belong to the SAME artifact: their captures come back together,
  /// in one `event::media`, and plugins analyse them together. A step is one
  /// continuous capture; a break the applicant must take between two (flip
  /// the card, turn the page) is a step boundary.
  record capture-step {
    /// An `icon-ref` minted by one of the functions of
    /// `enclavid:host-icons/icons`, one per icon the frontend draws, so a
    /// step carries an icon from that fixed set and never a free-form
    /// string. Not a text-ref because there's nothing to localise — the
    /// name is a frontend dispatch token, never displayed verbatim.
    icon: option<icon-ref>,
    /// The pre-capture intro body, a text of the component's `i18n`
    /// catalog. Paired with `icon` to form "what you're about to do".
    /// Shown before the camera turns on for THIS step — even between
    /// steps of a multi-step capture ("now flip to the back").
    instructions: localized-ref,
    /// The short on-camera overlay shown during capture ("Photo page",
    /// "Back side"), a text of the component's `i18n` catalog.
    label: localized-ref,
    /// The camera the step uses.
    camera: camera-facing,
    /// What the step records.
    kind: capture-kind,
  }

  /// Spec for one media render (`prompt::media`). Use multiple steps
  /// for multi-side / multi-page captures of the same artifact. Use
  /// multiple media renders for independent artifacts (e.g.,
  /// shareholder passports).
  record media-spec {
    /// The overall artifact title surfaced as context on every screen of
    /// the capture flow ("Your passport"). Per-step copy — pre-capture
    /// instructions, on-camera prompt — lives on `capture-step`.
    label: localized-ref,
    /// The steps, in the order the applicant takes them.
    captures: list<capture-step>,
    /// The seconds the applicant has for every step together, from when
    /// the page starts them. The page is given the steps' kinds only
    /// then, so what they ask is not known before; past the limit, the
    /// reply is `event::media` with `media-error::timed-out`. None: no
    /// limit, and the steps are given whole with the prompt.
    time-limit-secs: option<u16>,
  }
}

