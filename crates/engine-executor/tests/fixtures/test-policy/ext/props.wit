package enclavid-ext:policy@0.1.0;

/// The props this policy takes. The host serves `get`; the record is this
/// policy's own.
interface props {
    /// All are harness knobs, absent on every real flow.
    record props {
        /// Return a state blob of this many bytes from genesis, to drive the
        /// engine's POLICY_MAX_STATE_BYTES cap.
        state-bloat: option<u32>,
        /// Rehydrate the passport handle on the selfie round without reading
        /// its bytes, to prove the pull is lazy.
        skip-passport-read: option<bool>,
        /// Return what the round's WASI clocks and randomness read as the
        /// state from genesis, for the harness to check.
        wasi-probe: option<bool>,
    }

    get: func() -> props;
}
