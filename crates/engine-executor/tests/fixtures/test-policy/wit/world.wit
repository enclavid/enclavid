package enclavid:test-policy@0.1.0;

world policy {
    // Canonical KYC building blocks from the well-known plugin: pre-baked
    // capture flows and `display-field` helpers. Satisfied at /connect via
    // runtime composition — the consumer pins the plugin's `impl_ref` in
    // POST /sessions; the policy carries only these imports.
    import enclavid:well-known/photo@0.1.0;
    import enclavid:well-known/disclosure-fields@0.1.0;

    // The well-known plugin's texts, by its slot: the policy labels one of
    // its fields with the plugin's text for it, served from the plugin's
    // catalog.
    import enclavid-ext:well-known/i18n@0.1.0;

    // A second plugin, imported to exercise HYBRID composition: baked
    // into no core, linked at runtime on top of a pre-fused (policy +
    // well-known) core. `tag::get()` is one of the extra plugin's OWN
    // texts, through its own slot.
    import enclavid:extra/tag@0.1.0;

    // The face plugins over the host's image of the selfie: face-detect
    // locates the `face` in it; face-age reads its crop and estimates. The
    // policy just threads the handles image → detect → estimate.
    // `enclavid:vision/types` carries the shared `face` vocabulary the policy
    // holds in between.
    import enclavid:face-detect/detect@0.1.0;
    import enclavid:vision/types@0.1.0;

    // The face-age plugin: a real image + face consumer. No texts of its
    // own, so no slot.
    import enclavid:face-age/check@0.1.0;

    // The face-liveness plugin, on a probe: whether the face of the selfie
    // is live, or the faces of a video's frames.
    import enclavid:face-liveness/image@0.1.0;
    import enclavid:face-liveness/video@0.1.0;

    // The policy's slot, `enclavid-ext:policy` (`ext/`): its own texts; its
    // disclosure fields, those it hands the well-known helpers and its OWN
    // face-age estimate, which no helper covers; and the props the session
    // was created with, as the record this policy declares.
    // Capture and consent are driven by the `action` the policy returns from
    // `handle` (`render(prompt::media)` / `render(prompt::consent-disclosure)`),
    // not by suspending host imports.
    import enclavid-ext:policy/i18n@0.1.0;
    import enclavid-ext:policy/disclosure-fields@0.1.0;
    import enclavid-ext:policy/props@0.1.0;
    export enclavid:policy/policy@0.1.0;
}
