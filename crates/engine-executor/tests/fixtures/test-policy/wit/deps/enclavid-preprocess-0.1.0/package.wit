package enclavid:preprocess@0.1.0;

/// Decode a capture frame into a shared `decoded-frame`. The decode of the
/// untrusted JPEG runs HERE (sandboxed), and the pixels stay in this
/// plugin's memory — downstream face checks pull crops via
/// `decoded-frame.region`, so one decode serves all of them.
interface decode {
  use enclavid:host/types@0.1.0.{blob};
  use enclavid:vision/types@0.1.0.{decoded-frame};

  /// Source-decode fidelity tier. The caller materializes the tier(s) its
  /// plugin set needs — `eighth` for a detector alone (it reads the whole
  /// frame at a small side); `half` and up where a model reads the face's
  /// own crop, which an eighth of a selfie leaves a few dozen pixels.
  enum scale {
    eighth,
    quarter,
    half,
    full,
  }

  /// Decode one captured frame `blob` at `scale` → a `decoded-frame`.
  /// `none` = the blob is undecodable (the caller asks for a retake). The
  /// caller picks which frame of the clip to decode and borrows it here.
  decode: func(frame: borrow<blob>, scale: scale) -> option<decoded-frame>;
}

world preprocess {
  import enclavid:host/types@0.1.0;

  export enclavid:vision/types@0.1.0;
  export decode;
}
