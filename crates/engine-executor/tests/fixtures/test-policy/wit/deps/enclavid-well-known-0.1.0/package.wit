package enclavid:well-known@0.1.0;

/// DisplayField helpers for canonical KYC fields.
///
/// Each helper takes one of the POLICY's disclosure fields — the
/// `disclosure-field-key-ref` it mints from a case of the `key` in its
/// `enclavid-ext:policy/disclosure-fields`, the single source of truth for
/// what's disclosable to the consumer — and returns a `display-field` of
/// that field, labelled with THIS PLUGIN's text for it (applicant-facing).
///
/// A helper is meant for the field of its own name: `passport-number`
/// labels a passport number, so the policy passes it its
/// `passport-number` field. The consent screen shows every field's key
/// beside its label, so a field passed to another field's helper is on
/// the applicant's screen for them to see.
interface disclosure-fields {
  use enclavid:host/refs@0.1.0.{disclosure-field-key-ref};
  use enclavid:host-disclosure/disclosure@0.1.0.{display-field};

  /// ─── Document identifiers ──────────────────────────────────────
  passport-number: func(field: disclosure-field-key-ref, value: string) -> display-field;

  id-card-number: func(field: disclosure-field-key-ref, value: string) -> display-field;

  drivers-license-number: func(field: disclosure-field-key-ref, value: string) -> display-field;

  document-issuing-country: func(field: disclosure-field-key-ref, value: string) -> display-field;

  document-expiry: func(field: disclosure-field-key-ref, value: string) -> display-field;

  document-issued: func(field: disclosure-field-key-ref, value: string) -> display-field;

  /// ─── Identity ──────────────────────────────────────────────────
  given-name: func(field: disclosure-field-key-ref, value: string) -> display-field;

  family-name: func(field: disclosure-field-key-ref, value: string) -> display-field;

  full-name: func(field: disclosure-field-key-ref, value: string) -> display-field;

  date-of-birth: func(field: disclosure-field-key-ref, value: string) -> display-field;

  sex: func(field: disclosure-field-key-ref, value: string) -> display-field;

  nationality: func(field: disclosure-field-key-ref, value: string) -> display-field;

  /// ─── Contact / location ────────────────────────────────────────
  residence-country: func(field: disclosure-field-key-ref, value: string) -> display-field;

  address: func(field: disclosure-field-key-ref, value: string) -> display-field;

  email: func(field: disclosure-field-key-ref, value: string) -> display-field;

  phone: func(field: disclosure-field-key-ref, value: string) -> display-field;

  /// ─── Other ─────────────────────────────────────────────────────
  tax-id: func(field: disclosure-field-key-ref, value: string) -> display-field;
}

/// The shapes a document or a selfie is photographed in, with the values this
/// plugin picks for them.
interface shapes {
  use enclavid:host-capture/photo@0.1.0.{shape};

  /// The frame of an ICAO TD3 passport's photo page, 125 × 88 mm.
  passport-frame: func() -> shape;

  /// The frame of an ICAO TD1 card — ID cards and driving licences —
  /// 85.6 × 54 mm.
  card-frame: func() -> shape;

  /// The oval of a selfie taken with the shutter, the page reading no face
  /// in it: half the frame's shorter side wide, as `photo.selfie`'s is.
  selfie-oval: func() -> shape;
}

/// Ready sets of video guides for a check, their values drawn from a seed the
/// policy picks at random for each attempt: the same seed gives the same
/// guides.
interface video-guides {
  use enclavid:host-capture/video@0.1.0.{guide};

  /// A liveness check by turns: the face in an oval 0.40–0.55 of the frame's
  /// shorter side wide, held 0.8 s; then a turn of the head by 20–30° to one
  /// side and one to the other, each held 0.5 s.
  liveness-turns: func(seed: u32) -> list<guide>;

  /// A liveness check by colours: the face in an oval 0.40–0.55 of the
  /// frame's shorter side wide, held 0.8 s; then flashes of 5 bright colours
  /// in that oval, 0.3 s each. A seed gives both sets the same oval.
  liveness-colors: func(seed: u32) -> list<guide>;
}

/// Photo captures of documents, in `shapes`' frames, and a selfie, which the
/// page takes once the face fills its oval, half the frame's shorter side
/// wide; each kept or taken again on a review screen.
///
/// A document's function returns a whole `media-spec` for
/// `action::render(prompt::media)`, both sides of a two-sided one as steps
/// of their own; the `*-step` functions return those steps alone, for a
/// policy composing its own flow.
///
/// The texts inside the returned records (labels, instructions) are
/// THIS PLUGIN's own (`enclavid-ext:well-known/i18n`) — applicant-facing
/// only, no policy whitelist needed — and the icons are the host's own
/// (`enclavid:host-icons/icons`).
interface photo {
  use enclavid:host-capture/capture@0.1.0.{capture-step, media-spec};

  passport: func() -> media-spec;

  id-card: func() -> media-spec;

  drivers-license: func() -> media-spec;

  selfie: func() -> media-spec;

  id-card-front-step: func() -> capture-step;

  id-card-back-step: func() -> capture-step;

  drivers-license-front-step: func() -> capture-step;

  drivers-license-back-step: func() -> capture-step;
}

/// Video captures, with this plugin's texts and the host's icons, as
/// `photo`'s are.
interface video {
  use enclavid:host-capture/capture@0.1.0.{media-spec};
  use enclavid:host-capture/video@0.1.0.{guide};

  /// A liveness video: one step on the front camera asking `guides` in
  /// order — `video-guides` makes ready ones — with a time limit of 60 s.
  /// Any field of the spec is the policy's to change.
  liveness: func(guides: list<guide>) -> media-spec;
}

world well-known {
  import enclavid:host/refs@0.1.0;
  import enclavid-ext:well-known/i18n@0.1.0;
  import enclavid:host-icons/icons@0.1.0;
  import enclavid:host-disclosure/values@0.1.0;
  import enclavid:host-disclosure/disclosure@0.1.0;
  import enclavid:host-capture/photo@0.1.0;
  import enclavid:host-capture/video@0.1.0;
  import enclavid:host-capture/capture@0.1.0;

  export disclosure-fields;
  export shapes;
  export video-guides;
  export photo;
  export video;
}
