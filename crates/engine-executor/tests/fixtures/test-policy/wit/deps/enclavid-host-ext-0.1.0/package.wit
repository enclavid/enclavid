package enclavid:host-ext@0.1.0;

/// The disclosure fields this policy's consent screen may name: those of the
/// well-known helpers it calls, and its own face-age estimate. Embedding
/// writes the cases out as its list; the host serves `disclosure-field`.
interface disclosure-fields {
  use enclavid:host/types@0.1.0.{disclosure-field-ref};

  enum key {
    full-name,
    date-of-birth,
    nationality,
    passport-number,
    document-expiry,
    address,
    estimated-age,
  }

  disclosure-field: func(key: key) -> disclosure-field-ref;
}

/// The props this policy takes. The host serves `get`; the record is this
/// policy's own. Kept out of `wit/` and vendored into `wit/deps` by `wkg`,
/// which reads a package it does not find in a registry only from a path.
interface policy-props {
  /// All are harness knobs, absent on every real flow.
  record props {
    /// Return a state blob of this many bytes from genesis, to drive the
    /// engine's POLICY_MAX_STATE_BYTES cap.
    state-bloat: option<u32>,
    /// Rehydrate the passport handle on the selfie round without reading
    /// its bytes, to prove the pull is lazy.
    skip-passport-read: option<bool>,
    /// Return what the round's WASI clocks and randomness read as the
    /// state from genesis, for the harness to check.
    wasi-probe: option<bool>,
  }

  get: func() -> props;
}

