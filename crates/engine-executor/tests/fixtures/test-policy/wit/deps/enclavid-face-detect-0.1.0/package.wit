package enclavid:face-detect@0.1.0;

/// Locate the face in an image → `face` geometry the crop consumers (age,
/// liveness, face-match) reuse. Detection runs ONCE here; the pixels stay with
/// the host (this plugin pulls the detector input via `image.region`), and only
/// WHERE the face is crosses the boundary — each consumer derives its own crop.
///
/// MODEL-AGNOSTIC contract: any detector (BlazeFace, RetinaFace, YuNet, …)
/// satisfies it by shipping a distinct OCI artifact exporting this
/// interface; the model is pinned per session via `impl_ref`.
interface detect {
  use enclavid:host/media@0.1.0.{image};
  use enclavid:vision/types@0.1.0.{face};

  /// Detect the single most prominent face (a KYC capture is
  /// single-subject). `none` = no usable face, or an image that does not
  /// decode → the policy asks for a retake. The returned box + landmarks
  /// are normalized `[0,1]` over the image.
  detect: func(image: borrow<image>) -> option<face>;
}

world face-detect {
  import enclavid:host/media@0.1.0;
  import enclavid:vision/types@0.1.0;

  export detect;
}
/// A detector whose model the host runs: the model's graph is a layer beside
/// the component — named for the function of its slot that hands the model
/// out — and only the frame, at the model's side, leaves the sandbox, to that
/// model, in a process of its own.
world with-models {
  import enclavid:host/tensors@0.1.0;
  import enclavid-ext:face-detect/models@0.1.0;
  import enclavid:host/media@0.1.0;
  import enclavid:vision/types@0.1.0;

  export detect;
}
