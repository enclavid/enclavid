package enclavid:host@0.1.0;

/// The tensors a model's `run` takes and gives: one resource for each element
/// type, minted by the host from a tensor's dimensions and its elements, in
/// row-major order and as many as the dimensions hold. A `run` borrows the
/// tensors it is given and hands back tensors of its own; which element type
/// each one is, and which dimensions it takes, is its graph's to say.
///
/// Half-precision elements are their bits: IEEE 754 binary16 for `f16`, the
/// upper half of an `f32` for `bf16`.
interface tensors {
    resource tensor-f32 {
        constructor(dims: list<u64>, data: list<f32>);
        dims: func() -> list<u64>;
        data: func() -> list<f32>;
    }

    resource tensor-f64 {
        constructor(dims: list<u64>, data: list<f64>);
        dims: func() -> list<u64>;
        data: func() -> list<f64>;
    }

    resource tensor-f16 {
        constructor(dims: list<u64>, data: list<u16>);
        dims: func() -> list<u64>;
        data: func() -> list<u16>;
    }

    resource tensor-bf16 {
        constructor(dims: list<u64>, data: list<u16>);
        dims: func() -> list<u64>;
        data: func() -> list<u16>;
    }

    resource tensor-i8 {
        constructor(dims: list<u64>, data: list<s8>);
        dims: func() -> list<u64>;
        data: func() -> list<s8>;
    }

    resource tensor-u8 {
        constructor(dims: list<u64>, data: list<u8>);
        dims: func() -> list<u64>;
        data: func() -> list<u8>;
    }

    resource tensor-i16 {
        constructor(dims: list<u64>, data: list<s16>);
        dims: func() -> list<u64>;
        data: func() -> list<s16>;
    }

    resource tensor-u16 {
        constructor(dims: list<u64>, data: list<u16>);
        dims: func() -> list<u64>;
        data: func() -> list<u16>;
    }

    resource tensor-i32 {
        constructor(dims: list<u64>, data: list<s32>);
        dims: func() -> list<u64>;
        data: func() -> list<s32>;
    }

    resource tensor-u32 {
        constructor(dims: list<u64>, data: list<u32>);
        dims: func() -> list<u64>;
        data: func() -> list<u32>;
    }

    resource tensor-i64 {
        constructor(dims: list<u64>, data: list<s64>);
        dims: func() -> list<u64>;
        data: func() -> list<s64>;
    }

    resource tensor-u64 {
        constructor(dims: list<u64>, data: list<u64>);
        dims: func() -> list<u64>;
        data: func() -> list<u64>;
    }
}
