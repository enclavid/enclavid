# Role: the storage CVM only. Layered on top of common.config.
#
# This is the one CVM that is supposed to persist, so it gets a block device and
# a filesystem — `crates/storage` keeps one bundled-SQLite database file per
# session plus the L2 cwasm blob cache through `object_store`.
#
# Its safety does not come from being unable to write. It comes from being
# blind: every payload arrives already AEAD-sealed under `tee_seal_key` on the
# TEE side, so this CVM holds no key and sees no plaintext, and its measurement
# is pinned separately from the diskless roles. A disk full of its ciphertext is
# worth what any other ciphertext is worth.
#
# Everything else common.config removes stays removed — no IP stack, no modules,
# no tracing. The delta is storage and only storage.

CONFIG_BLOCK=y
CONFIG_VIRTIO_BLK=y

# ext4 for the session databases and the blob cache. Journalled, and the format
# SQLite is most exercised against.
CONFIG_EXT4_FS=y

# Everything else that CONFIG_BLOCK would otherwise drag in stays out: there is
# exactly one virtio disk, so no discovery, no multipath, no volume management.
# CONFIG_SCSI is not set
# CONFIG_ATA is not set
# CONFIG_BLK_DEV_NVME is not set
# CONFIG_MD is not set
# CONFIG_BTRFS_FS is not set
# CONFIG_XFS_FS is not set
# CONFIG_FAT_FS is not set
# CONFIG_ISO9660_FS is not set
# CONFIG_MISC_FILESYSTEMS is not set
# CONFIG_NETWORK_FILESYSTEMS is not set
# CONFIG_QUOTA is not set
# CONFIG_FUSE_FS is not set
