# Role: every CVM that must not be able to persist anything — api, executor,
# compiler, gateway. Layered on top of common.config.
#
# These roles boot from kernel + initramfs and are given no block device. The
# initramfs is a cpio unpacked into ramfs, which does not go through the block
# layer, so clearing CONFIG_BLOCK takes the whole storage stack with it: SCSI,
# ATA, NVMe, virtio-blk, MD, device-mapper, partition parsers. Nothing in the
# guest can address a sector, and that is a property of the binary rather than
# of how the VM was launched.
#
# Note the narrow claim. "Cannot write to a disk" is not "no guest data reaches
# host storage": the serial console is plaintext the host may capture, and every
# virtio DMA passes through unencrypted bounce buffers under SNP. Those paths are
# covered by RA-TLS and by AEAD-sealing before anything leaves, not here.
# CONFIG_BLOCK is not set

# ─── Filesystems: RAM only ──────────────────────────────────────────────────
# ramfs (initramfs) and tmpfs (/tmp, /run) are the only ones mounted, plus proc
# and sysfs from common.config. Every on-disk format is dead code here.
# CONFIG_EXT4_FS is not set
# CONFIG_BTRFS_FS is not set
# CONFIG_XFS_FS is not set
# CONFIG_FAT_FS is not set
# CONFIG_MSDOS_FS is not set
# CONFIG_VFAT_FS is not set
# CONFIG_ISO9660_FS is not set
# CONFIG_MISC_FILESYSTEMS is not set
# CONFIG_NETWORK_FILESYSTEMS is not set
# CONFIG_QUOTA is not set
# CONFIG_FUSE_FS is not set

# ─── fw_cfg: what the host decides at launch ────────────────────────────────
# api takes the host ports of its three fleet legs from QEMU's fw_cfg rather
# than from its measured command line (crates/api/src/fleet/legs.rs), so where
# a release's legs lead is the host's choice and not part of any measurement. The driver finds the device through ACPI QEMU0002, which QEMU
# always describes, and reads through the IO-port interface — each access a #VC
# serviced over the GHCB under SNP, the path ttyS0 takes. fw_cfg is host data
# the firmware already reads — the ACPI tables this driver is found through,
# the e820 map — but turns only kernel, initrd and cmdline into something it
# boots (QemuLoaderFs's closed name set, image/ovmf/README.md), so nothing named
# here becomes code.
CONFIG_FW_CFG_SYSFS=y
# The driver also WRITES one file, vmcoreinfo, by DMA from a kmalloc'd buffer —
# private memory under SNP, which QEMU cannot read, so a guest offered
# etc/vmcoreinfo would spin for ever waiting on the device. That write is
# compiled in with VMCORE_INFO, which PROC_KCORE selects here (CRASH_DUMP, its
# other selector, is off in common.config); nothing in these roles reads
# /proc/kcore.
# CONFIG_PROC_KCORE is not set
