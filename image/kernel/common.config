# Guest kernel — the delta from upstream `make defconfig` shared by every role.
#
# Published as a fragment rather than a full .config on purpose: a reviewer can
# read this file end to end, and `defconfig` is the kernel's own answer to
# "reasonable starting point". Every line below states why it is here.
#
# Roles differ only in whether they may touch storage; see diskless.config and
# storage.config. Applied as:
#   make defconfig
#   scripts/kconfig/merge_config.sh -m .config common.config <role>.config
#   make olddefconfig

# ─── SEV-SNP guest ──────────────────────────────────────────────────────────
# Built in, never a module: the initramfs carries no modules to load (see the
# CONFIG_MODULES section), so /dev/sev-guest has to exist before userspace runs.
CONFIG_AMD_MEM_ENCRYPT=y
CONFIG_SEV_GUEST=y
CONFIG_VIRT_DRIVERS=y

# ─── Transport: vsock only, no IP stack ─────────────────────────────────────
# AF_UNIX (supervisor <-> disposable child) and AF_VSOCK (everything leaving the
# guest) both live under CONFIG_NET but neither depends on CONFIG_INET. Leaving
# INET unset means the guest has no TCP/UDP implementation at all — `socket(2)`
# on AF_INET returns EAFNOSUPPORT because there is nothing to answer it. That is
# a stronger, greppable form of "the CVM cannot reach the network" than omitting
# a NIC driver would be.
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
# virtio-console is a second character channel to the host that nothing here
# uses, and virtio-input would attach a keyboard to a machine with no operator
# at the keyboard.
# CONFIG_VIRTIO_CONSOLE is not set
# CONFIG_VIRTIO_INPUT is not set
# The 9P filesystem is already gone with NETWORK_FILESYSTEMS, but the protocol
# and its virtio transport live in a different menu and survive defconfig. With
# no filesystem on top there is nothing to mount, so this is dead code — but it
# is dead code that registers a virtio driver, so it goes too.
# CONFIG_NET_9P is not set
# CONFIG_INET is not set
# CONFIG_IPV6 is not set
# CONFIG_PACKET is not set
# CONFIG_NETDEVICES is not set
# CONFIG_WIRELESS is not set
# CONFIG_BT is not set

# ─── No code loading after boot ─────────────────────────────────────────────
# The kernel physically cannot gain code once launched. Also removes the module
# signing question from the reproducibility recipe entirely.
# CONFIG_MODULES is not set
# With nothing to verify — no modules, no signed firmware, no kexec — the
# built-in keyrings have no consumer. Dropping them also drops certs/extract-cert
# from the build, a host tool that has no business existing in this recipe.
# CONFIG_SYSTEM_TRUSTED_KEYRING is not set
# CONFIG_SECONDARY_TRUSTED_KEYRING is not set
# CONFIG_SYSTEM_BLACKLIST_KEYRING is not set

# ─── What the runtime actually calls ────────────────────────────────────────
# engine-supervisor installs a seccomp BPF filter on the disposable child via
# seccomp(2)/SECCOMP_SET_MODE_FILTER after PR_SET_NO_NEW_PRIVS.
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
# tokio's multi-threaded runtime: epoll + futex.
CONFIG_EPOLL=y
CONFIG_FUTEX=y
# execution-worker hands each child its composition's cwasm as a sealed memfd;
# sealing is a shmem feature. tmpfs also backs /tmp and /run.
CONFIG_SHMEM=y
CONFIG_TMPFS=y
CONFIG_MEMFD_CREATE=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y

# io_uring is not among them, and it is worth saying why rather than leaving a
# defconfig default in place. It performs opens, writes and socket calls in
# kernel worker context, so they never cross the syscall entry where a seccomp
# filter sits: a task submits ring entries and calls io_uring_enter, and a
# filter watching openat and socket sees neither. The disposable children's
# syscall allowlist (engine-supervisor) denies io_uring_setup for exactly that
# reason, and this is the same denial one layer down — in the kernel image, whose
# hash is measured, rather than in a filter the application has to install
# correctly on every spawn.
#
# Nothing here wants it: tokio does not use io_uring, and the workspace has no
# dependency on it. It is `default y` in init/Kconfig with the prompt behind
# EXPERT, which this config sets, so clearing it is honoured.
# CONFIG_IO_URING is not set

# ─── Boot under OVMF ────────────────────────────────────────────────────────
# QEMU hands kernel/initrd/cmdline through fw_cfg; OVMF verifies them against
# the measured hashes table and boots via the EFI stub.
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
# Serial is the only console; there is no display device in the guest, and
# whatever the kernel prints there is plaintext the host can capture.
#
# Omitting `console=` does NOT turn that off, which is worth stating because it
# is the opposite of what it looks like: with no `console=`, printk enables the
# FIRST console that registers. On an ordinary x86 kernel the VT console absorbs
# that, but CONFIG_VT is off here — so the 8250 registers first and comes up
# enabled, with CON_PRINTBUFFER replaying the whole boot log. A production
# command line therefore has to say `console=null` and mean it; silence is not
# the default.
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
# The console `console=null` names. Without it that token would name nothing and
# the silence would rest on a lookup failing rather than on a console that
# discards.
CONFIG_NULL_TTY=y
# No virtual terminal: there is no screen, and VT is what keeps the whole input
# subsystem alive.
# CONFIG_VT is not set
# The legacy iSCSI boot-firmware-table scan walks low memory looking for a BIOS
# signature. Nothing here boots from iSCSI, and the scan is pure attack surface.
# CONFIG_ISCSI_IBFT is not set
# CONFIG_ISCSI_IBFT_FIND is not set

# ─── Unlock the trims in the role fragments ─────────────────────────────────
# Several symbols the role fragments clear are declared `bool "..." if EXPERT`,
# so without EXPERT they are not user-settable and silently keep their
# `default y` no matter what a fragment says. CONFIG_BLOCK is one of them.
CONFIG_EXPERT=y

# ─── Introspection and code-injection surfaces ──────────────────────────────
# Nothing in the guest traces or debugs itself, and there is no operator shell
# to run a tracer from. Each of these is a live in-kernel mechanism for
# redirecting execution, so they are removed rather than left unused.
# CONFIG_KPROBES is not set
# CONFIG_FTRACE is not set
# CONFIG_KEXEC is not set
# CONFIG_KEXEC_FILE is not set
# CONFIG_CRASH_DUMP is not set
# CONFIG_PROFILING is not set
# CONFIG_PERF_EVENTS cannot be cleared: arch/x86/Kconfig selects it
# unconditionally for x86_64. Left in place deliberately, not overlooked.

# ─── No 32-bit userspace ────────────────────────────────────────────────────
# Everything in the image is x86-64. Dropping compat removes the 32-bit syscall
# entry path and the 32-bit vDSO — a whole second ABI into the kernel that no
# process here could use, and historically a fertile source of privilege bugs.
# CONFIG_IA32_EMULATION is not set

# ─── No operator, no debug backdoors ────────────────────────────────────────
# SysRq is a control channel reachable from the serial line the host owns.
# CONFIG_MAGIC_SYSRQ is not set
# DEBUG_KERNEL does NOT take: `menuconfig EXPERT` selects it (init/Kconfig),
# and this file sets EXPERT to reach options that are otherwise hidden. Kept
# because it costs nothing and would take effect if that ever changed. It is a
# menu gate rather than code — what it unhides is cleared by name above and
# below (KPROBES, FTRACE, GDB_SCRIPTS, KALLSYMS_ALL), so the surface is gone
# even though the gate is open. Verified with kconfig, not assumed.
# CONFIG_DEBUG_KERNEL is not set

# ─── No audit subsystem ─────────────────────────────────────────────────────
# AUDITSYSCALL puts work on every syscall to feed a userspace daemon that will
# never exist in this image. Diagnostics leave over RA-TLS, not over auditd.
# CONFIG_AUDIT is not set

# ─── One plain serial port ──────────────────────────────────────────────────
# QEMU exposes a single legacy 16550A. Everything else the 8250 driver can bind
# — PCI cards, Exar, Pericom, Intel LPSS/MID — is hardware no CVM will ever see.
# CONFIG_SERIAL_8250_PCI is not set
# CONFIG_SERIAL_8250_EXAR is not set
# CONFIG_SERIAL_8250_EXTENDED is not set
# CONFIG_SERIAL_8250_DMA is not set
# CONFIG_SERIAL_8250_LPSS is not set
# CONFIG_SERIAL_8250_MID is not set
# CONFIG_SERIAL_8250_PERICOM is not set
# CONFIG_SERIAL_8250_DEPRECATED_OPTIONS is not set
# CONFIG_SERIAL_NONSTANDARD is not set

# ─── A filesystem nothing mounts ────────────────────────────────────────────
# CONFIG_HUGETLBFS is not set

# ─── In-kernel crypto: only what attestation needs ──────────────────────────
# The crypto API itself cannot be cleared, and for a good reason: CONFIG_SEV_GUEST
# selects it. The guest-message channel to the PSP is AES-GCM under the VMPCK, so
# the subsystem that carries our attestation reports is the subsystem pulling
# CRYPTO in. Confirmed by intersecting every `select CRYPTO` in the tree against
# this config — SEV_GUEST is the only match.
#
# The handful of algorithms that come along with it are left alone deliberately.
# Picking them off one by one buys about 20 KB and costs a failure mode: a path
# that needs one of them, now or after a kernel bump, breaks quietly. This file
# removes whole areas the image has no use for, not individual leaves of an area
# it does use.
#
# INTEGRITY (IMA/EVM) goes for its own sake, not to reach CRYPTO: it measures and
# signature-checks files entering the kernel, which in an image with no modules,
# no disk and no IMA policy has nothing to act on. The equivalent guarantee here
# is the launch measurement.
# CONFIG_INTEGRITY is not set

# ─── Power management ───────────────────────────────────────────────────────
# SCHED_MC_PRIO is `default y` and selects X86_AMD_PSTATE and CPU_FREQ. It ranks
# physical cores by turbo headroom — a decision belonging to whoever owns the
# silicon, which is not the guest. Clearing it is what actually removes CPU_FREQ.
# CONFIG_SCHED_MC_PRIO is not set
# A CVM never suspends, and it does not own the physical CPU's frequency or
# idle states — the host does. None of this has anything to drive.
# CONFIG_SUSPEND is not set
# CONFIG_CPU_FREQ is not set
# CPU_IDLE does NOT take: ACPI_PROCESSOR_IDLE selects it, and that arrives with
# ACPI_PROCESSOR, which nothing here clears. Clearing ACPI_PROCESSOR would
# remove this, THERMAL and ACPI_CONTAINER together — measured, 58 config lines —
# but it changes how the guest idles and cannot be checked short of booting one.
# CONFIG_CPU_IDLE is not set
# CONFIG_ACPI_CPPC_LIB is not set

# ─── Grouping and isolation the runtime does not use ────────────────────────
# engine-supervisor confines the disposable child with seccomp + RLIMIT_AS +
# no_new_privs, never with namespaces or cgroups, and there is no init system
# here that would want them. Verified against the code, not assumed.
# CONFIG_CGROUPS is not set
# CONFIG_NAMESPACES is not set

# ─── Machine topology and host hardware faults ──────────────────────────────
# The guest sees flat memory, and it can do nothing useful about a physical
# machine check on a host it does not own.
# CONFIG_NUMA is not set
# CONFIG_X86_MCE is not set
# DMA under SNP goes through swiotlb bounce buffers, which is a separate symbol;
# the IOMMU layer would only ever bind a virtual IOMMU we do not attach.
# CONFIG_IOMMU_SUPPORT is not set

# ─── Hardware the guest does not have ───────────────────────────────────────
# CONFIG_ACPI_AC is not set
# CONFIG_ACPI_BATTERY is not set
# CONFIG_ACPI_FAN is not set
# CONFIG_ACPI_DOCK is not set
# CONFIG_ACPI_THERMAL is not set
# ACPI_CONTAINER does NOT take: ACPI_HOTPLUG_CPU selects it, and that arrives
# with ACPI_PROCESSOR. See CPU_IDLE above — one symbol holds all three.
# CONFIG_ACPI_CONTAINER is not set
# CONFIG_WATCHDOG is not set
# CONFIG_I2C is not set
# CONFIG_PTP_1588_CLOCK is not set
# CONFIG_SOUND is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_DRM is not set
# CONFIG_FB is not set
# CONFIG_HID is not set
# CONFIG_INPUT is not set
# CONFIG_PCMCIA is not set
# CONFIG_MEDIA_SUPPORT is not set
# THERMAL does NOT take: ACPI_PROCESSOR selects it. See CPU_IDLE above.
# CONFIG_THERMAL is not set
# CONFIG_HWMON is not set

# ─── ptrace ─────────────────────────────────────────────────────────────────
# Yama is the LSM that restricts ptrace, and it is the only one enabled: without
# it a process may read the memory of any other process under the same uid, and
# in this guest everything is that uid — PID 1 runs the application as root and
# the workers' per-round children inherit it. The command line sets
# `sysctl.kernel.yama.ptrace_scope=3` ("no attach"), which denies every process
# including one holding CAP_SYS_PTRACE, and cannot be lowered again without a
# reboot. Nothing here calls ptrace, so the guest gives up nothing for it.
#
# CONFIG_LSM names ONE module rather than taking the default list: every other
# entry would be code in a measured image that nothing uses.
CONFIG_SECURITY=y
CONFIG_SECURITY_YAMA=y
CONFIG_LSM="yama"

# ─── Reproducible build ─────────────────────────────────────────────────────
# https://docs.kernel.org/kbuild/reproducible-builds.html — the build must also
# pin KBUILD_BUILD_USER / KBUILD_BUILD_HOST / KBUILD_BUILD_TIMESTAMP; see
# default.nix. Debug info is dropped outright: it is the largest source of
# toolchain-dependent bytes and nothing in the guest consumes it.
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_MODULE_SIG is not set
# CONFIG_GDB_SCRIPTS is not set
# CONFIG_KALLSYMS_ALL is not set
