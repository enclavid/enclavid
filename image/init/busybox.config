# Guest PID 1 — the delta from busybox's `make allnoconfig`.
#
# Starting from nothing rather than from defconfig is deliberate: busybox's
# value to most users is its toolbox, and the toolbox is exactly what a CVM
# must not carry. An attacker who reaches native code inside the guest should
# find an empty address space, not four hundred ready-made utilities.
#
# So this file is an allowlist. Four applets, and each one has to justify itself.

# Nothing to dynamically link against: the initramfs holds no libc and no
# loader, and adding one would mean shipping and measuring it.
CONFIG_STATIC=y

# PID 1 itself. It mounts what the runtime needs, starts /bin/app, reaps the
# orphans that `engine-supervisor`'s disposable children leave behind when a
# worker dies, and powers the machine down when the application is done.
CONFIG_INIT=y
CONFIG_FEATURE_USE_INITTAB=y

# The pseudo-filesystems: /proc, /sys, /dev, and tmpfs for /tmp and /run. Needed
# by every role including the diskless ones — none of these touch a block
# device, so clearing CONFIG_BLOCK in the kernel does not remove the need.
CONFIG_MOUNT=y
# Without this, `-o nosuid,nodev,noexec` is not recognised as flags at all: both
# the flag table and the option-name table in util-linux/mount.c are wrapped in
# IF_FEATURE_MOUNT_FLAGS, so the words fall through into the filesystem's data
# string and the kernel rejects the mount with "Unknown parameter 'nosuid'".
# The failure is silent in the sense that it looks like a mount syntax problem
# rather than a missing feature.
CONFIG_FEATURE_MOUNT_FLAGS=y

# Stopping the machine. `poweroff` is what the inittab uses — a finished CVM
# should stop existing rather than idle holding a session's memory.
#
# All three are separate symbols but one code path with three names, measured:
# enabling or clearing halt and reboot moves the binary by zero bytes. They stay
# because these are the conventional verbs and omitting them would surprise
# without buying anything — `reboot(2)` is a syscall any process with
# CAP_SYS_BOOT can make, so a missing applet withholds no capability.
#
# CONFIG_HALT alone is not enough: it builds only `halt`, and the inittab's
# `poweroff -f` then fails with "applet not found" — quietly, because init
# reports that it *started* the command either way.
CONFIG_POWEROFF=y
CONFIG_HALT=y
CONFIG_REBOOT=y

# No shell, at any price — the most important property in this file. A shell
# would hand an escaped process an interpreter, and stripping the kernel of
# every mechanism it could pick up would have been for nothing.
#
# This needs all four lines, and the reason is a trap worth stating. `sh` is a
# kconfig *choice*, and `allnoconfig` picks its default, SH_IS_ASH — which then
# `select`s SHELL_ASH and compiles the whole ash interpreter in. Clearing
# CONFIG_ASH does NOT undo that: per busybox's own help text, ASH controls only
# whether the shell is reachable under the name `ash`, and the interpreter stays
# callable as `sh` regardless. The choice member itself has to be cleared.
#
# Do not trust `strings busybox | grep sh` to confirm this. Check by running the
# built binary: `./busybox sh -c 'echo x'` must fail with "applet not found".
# CONFIG_SH_IS_ASH is not set
# CONFIG_SH_IS_HUSH is not set
CONFIG_SH_IS_NONE=y
# CONFIG_ASH is not set
# CONFIG_HUSH is not set
