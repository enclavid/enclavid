/// Capabilities the TEE host provides to the policy live in the RESERVED
/// `enclavid:host` package, and in any `enclavid:host-*` one: a composed plugin
/// may `import` an interface there (reading the same host surface the policy
/// does), but it must never SATISFY one. Runtime fusion refuses to wire a plugin
/// export into a host-reserved import and rejects outright any plugin that
/// exports one — host interfaces are served exclusively by the TEE `Linker`.
/// New host capabilities land as new interfaces in these packages, so the trust
/// boundary stays a single prefix check rather than a denylist that must be kept
/// in sync.
///
/// `enclavid:host-icons` holds the icons the applicant frontend draws, in a
/// package of its own so that a new icon moves that package's version alone.
/// `enclavid:host-capture` and `enclavid:host-disclosure` hold the shapes the
/// host renders a capture and a consent screen from, each in a package of its
/// own so that each moves its own version.
///
/// What a component declares itself, because the types are its own, it
/// declares in its slot, a package of the `enclavid-ext` namespace the host
/// serves as well. Every component's texts: `enclavid-ext:<slot>/i18n`, whose
/// `key` enum has a case for each text and whose `localized` mints the text of
/// a case, served from the catalog that names the slot. A plugin's slot is named
/// for its package; the policy's is `enclavid-ext:policy`, which holds as well
/// `props`, whose `get` returns the props the consumer gave the session
/// in whatever record the policy declares for them, and `disclosure-fields`,
/// whose `key` lists the fields its disclosures may name. A component may import
/// another's texts by its slot.
///
/// A component's models: `enclavid-ext:<slot>/models`, a function for each ONNX
/// model its artifact carries beside its component — a layer `<function>.onnx`,
/// the graph, and where its weights are large `<function>.onnx.data`, the data
/// file the graph points into — returning a resource the slot declares, whose
/// one method `run` borrows a tensor of `enclavid:host/tensors` for each input
/// of the graph and returns one for each output: as itself, or a tuple or a
/// record of them for more than one. The host serves the resource: the model
/// runs in a process of its own beside the round, started the first time a
/// round calls the function. Only the one artifact that imports a slot's models
/// is served them, and only its own files.
package enclavid:host@0.1.0;

/// The applicant's captures as the host holds them: each stored once, sealed,
/// by the hash of its bytes; minted by the runtime into `event::media` and
/// rehydrated across rounds by that hash. They live in the host package, not
/// in `enclavid:policy`, so the policy and any verification plugin hold the
/// SAME resource types and can pass a handle across the fused policy↔plugin
/// boundary; the bytes stay host-side and enter a component's linear memory
/// only when it pulls them.
///
/// A capture's pictures — a photo's, a video's frames — are `image`s, which
/// the platform decodes in a process of its own, one a capture: the one place
/// the applicant's media is parsed. A round decodes 16 captures at most: the
/// 17th traps.
///
/// A capture's type says which kind of step took it, not that its bytes are
/// what that kind should hold: the applicant's page sent them, so whatever
/// reads them must expect anything.
interface media {
  /// A capture's content ADDRESS — the hex-encoded 32-byte BLAKE3 of its
  /// bytes. A serializable value, unlike the opaque per-round handles: the
  /// policy stashes it in its sealed `state` and hands it to a constructor
  /// to rehydrate the capture in a later round; it never inspects it. A
  /// string rather than bytes for every language's sake: JSON-safe,
  /// `==`-comparable, usable as a map key (`[]byte` cannot even be a Go map
  /// key).
  type media-hash = string;

  /// A picture's size in pixels.
  record size {
    width: u32,
    height: u32,
  }

  /// A rectangle of a picture, in its pixels.
  record rect {
    /// Its left edge.
    x: u32,
    /// Its top edge.
    y: u32,
    width: u32,
    height: u32,
  }

  /// How pixels are brought to another size.
  enum resize-mode {
    /// Each output pixel is the source pixel nearest its place: the
    /// quicker, and no colour the picture does not have.
    nearest,
    /// Each output pixel is the mean of the source pixels it covers: a
    /// shrunk picture without aliasing, and a single pixel the mean of
    /// all.
    average,
  }

  /// Pixels brought to another size.
  record resize {
    /// The size they are brought to.
    size: size,
    mode: resize-mode,
  }

  /// Which of a picture's pixels, and at what size.
  record pixels-options {
    /// Only these, held to the picture; the whole picture where none.
    crop: option<rect>,
    /// Brought to another size; at their own where none.
    resize: option<resize>,
  }

  /// A picture of the applicant's — a photo, or a frame of a video — as the
  /// platform decodes it. Nothing is decoded until its pixels are read;
  /// reading them again decodes nothing again, and a video's frame read out
  /// of order is decoded from the nearest keyframe before it.
  resource image {
    /// Its size: its longer side at most 1920 pixels and its shorter
    /// 1080, whichever way it is turned.
    size: func() -> size;
    /// Every pixel of it, at its size, RGB8 row by row, decoding the
    /// image first where nothing did; `none` where it does not decode.
    /// Traps where the process decoding it has stopped answering.
    all-pixels: func() -> option<list<u8>>;
    /// The pixels `options` pick, RGB8 row by row, decoding the image
    /// first where nothing did; `none` where it does not decode. Traps
    /// for an output over 1920×1080 pixels, or where the process
    /// decoding it has stopped answering.
    pixels: func(options: pixels-options) -> option<list<u8>>;
  }

  /// A photo the applicant kept on the review screen: one JPEG, as the
  /// camera page encoded it.
  resource photo {
    /// Rehydrate the photo with this hash from the session's store.
    /// Own-session only (cross-session is cryptographically blocked).
    /// Returns a COLD handle — no host IO yet; the bytes are pulled on the
    /// first `bytes()`. TRAPS on a miss (an unknown or malformed hash): a
    /// correct policy only stashes hashes it got from a real `hash()`, so
    /// a fabricated one fails loud rather than handing it a recoverable
    /// branch.
    constructor(hash: media-hash);
    /// Pull the photo's bytes into the caller's linear memory: for a
    /// rehydrated photo, the lazy load point. Bounded by the round's
    /// memory max: a round that goes past it is ended.
    bytes: func() -> list<u8>;
    /// The photo's hash — stash it in `state` to rehydrate the photo in a
    /// later round.
    hash: func() -> media-hash;
    /// The photo as an image; `none` where it is not a JPEG the platform
    /// decodes. One past the image's bounds is decoded at half its size
    /// where that fits them, and is none where it does not.
    image: func() -> option<image>;
  }

  /// One frame of a video, as its container lists it.
  record frame {
    /// Its index in the video, from 0.
    index: u32,
    /// When it is shown, in milliseconds from the video's first frame, as
    /// the page's encoder stamped it.
    timestamp-ms: u32,
    /// Whether the encoder wrote it whole, not as a change to the frames
    /// before it.
    keyframe: bool,
    /// Its picture.
    image: image,
  }

  /// A video the applicant recorded: a WebM of VP8 frames, as the page's
  /// encoder wrote it.
  resource video {
    /// Rehydrate the video with this hash from the session's store, as
    /// `photo`'s constructor does.
    constructor(hash: media-hash);
    /// Pull the video's bytes into the caller's linear memory, as
    /// `photo`'s `bytes` does.
    bytes: func() -> list<u8>;
    /// The video's hash — stash it in `state` to rehydrate the video in a
    /// later round.
    hash: func() -> media-hash;
    /// Frames `first` to `last` of the video, in order, as a guide's
    /// `frame-range` names them; none is decoded until its image is read.
    /// The list ends at the video's last frame, its 900th, or the frame
    /// before a keyframe of another size than the video's; it is empty
    /// where the video is not a WebM of VP8 frames within the image's
    /// bounds.
    frames: func(first: u32, last: u32) -> list<frame>;
  }
}

/// The handles the host mints for what a prompt is made of: RESOURCES a
/// component cannot construct, minted only through a slot's `i18n`, the
/// policy's `disclosure-fields`, and `enclavid:host-icons/icons`. The handle IS
/// the proof the key was declared, so membership needs no crypto token. A
/// plugin's helper that names a field takes the `disclosure-field-ref` the
/// policy minted. They live HERE (a shared interface) rather than inside each
/// interface that mints them, so every slot's `i18n` mints the SAME resource
/// type that the records a prompt is made of carry, and every version of
/// `enclavid:host-icons` mints the one `icon-ref` that `capture-step` carries.
interface refs {
  /// One of a component's texts, in every language its catalog has it in —
  /// surfaces as UI text once the host picks the applicant's language.
  resource localized-ref;

  /// An icon from `enclavid:host-icons/icons`, which the applicant
  /// frontend draws by its name.
  resource icon-ref;

  /// One of the policy's disclosure fields — surfaces as the machine
  /// `display-field.key` the consumer receives.
  resource disclosure-field-ref;
}

/// The tensors a model's `run` takes and gives: one resource for each element
/// type, minted by the host from a tensor's dimensions and its elements, in
/// row-major order and as many as the dimensions hold. A `run` borrows the
/// tensors it is given and hands back tensors of its own; which element type
/// each one is, and which dimensions it takes, is its graph's to say.
///
/// Half-precision elements are their bits: IEEE 754 binary16 for `f16`, the
/// upper half of an `f32` for `bf16`.
interface tensors {
  resource tensor-f32 {
    constructor(dims: list<u64>, data: list<f32>);
    dims: func() -> list<u64>;
    data: func() -> list<f32>;
  }

  resource tensor-f64 {
    constructor(dims: list<u64>, data: list<f64>);
    dims: func() -> list<u64>;
    data: func() -> list<f64>;
  }

  resource tensor-f16 {
    constructor(dims: list<u64>, data: list<u16>);
    dims: func() -> list<u64>;
    data: func() -> list<u16>;
  }

  resource tensor-bf16 {
    constructor(dims: list<u64>, data: list<u16>);
    dims: func() -> list<u64>;
    data: func() -> list<u16>;
  }

  resource tensor-i8 {
    constructor(dims: list<u64>, data: list<s8>);
    dims: func() -> list<u64>;
    data: func() -> list<s8>;
  }

  resource tensor-u8 {
    constructor(dims: list<u64>, data: list<u8>);
    dims: func() -> list<u64>;
    data: func() -> list<u8>;
  }

  resource tensor-i16 {
    constructor(dims: list<u64>, data: list<s16>);
    dims: func() -> list<u64>;
    data: func() -> list<s16>;
  }

  resource tensor-u16 {
    constructor(dims: list<u64>, data: list<u16>);
    dims: func() -> list<u64>;
    data: func() -> list<u16>;
  }

  resource tensor-i32 {
    constructor(dims: list<u64>, data: list<s32>);
    dims: func() -> list<u64>;
    data: func() -> list<s32>;
  }

  resource tensor-u32 {
    constructor(dims: list<u64>, data: list<u32>);
    dims: func() -> list<u64>;
    data: func() -> list<u32>;
  }

  resource tensor-i64 {
    constructor(dims: list<u64>, data: list<s64>);
    dims: func() -> list<u64>;
    data: func() -> list<s64>;
  }

  resource tensor-u64 {
    constructor(dims: list<u64>, data: list<u64>);
    dims: func() -> list<u64>;
    data: func() -> list<u64>;
  }
}

