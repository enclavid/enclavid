package enclavid:face-detect@0.1.0;

/// Locate the face in an image → `face` geometry the crop consumers (age,
/// liveness, face-match) reuse. Detection runs ONCE here; the pixels stay with
/// the host (this plugin pulls the detector input via `image.pixels`), and only
/// WHERE the face is crosses the boundary — each consumer derives its own crop.
///
/// MODEL-AGNOSTIC contract: any detector satisfies it by shipping a distinct
/// OCI artifact exporting this interface; the model is pinned per session via
/// `impl_ref`.
interface detect {
    use enclavid:host/media@0.1.0.{image};
    use enclavid:vision/types@0.1.0.{face};

    /// Detect the single most prominent face (a KYC capture is
    /// single-subject). `none` = no usable face, or an image that does not
    /// decode → the policy asks for a retake. The returned box and
    /// keypoints are in the image's pixels.
    detect: func(image: borrow<image>) -> option<face>;
}

/// What a face's keypoints say of its pose, read as this detector places
/// them: an implementation exports it where its keypoints tell.
interface pose {
    use enclavid:vision/types@0.1.0.{face};

    /// How far the head of `faces` — one head in frames of a video, as this
    /// detector found it — is turned, read from them together: in degrees,
    /// negative to its own left, as a `head-turn` guide counts them. A head
    /// reads a few degrees off even straight on, so a turn is the difference
    /// from its own straight reading. None where no face's keypoints tell.
    head-turn: func(faces: list<face>) -> option<f32>;
}

/// The face in a picture — a photo's image, or a frame's — read against a
/// photo's guide.
///
/// The guides here and in `video` are copied from `enclavid:host-capture`'s
/// interfaces of the same names, under the same names and fields but those
/// this reader has no use for, so a policy hands the platform's over as they
/// are. A kind the platform adds is read once a version of this package copies
/// it; until then a policy leaves it out.
interface photo {
    use enclavid:host/media@0.1.0.{image};
    use enclavid:vision/types@0.1.0.{face};

    /// Read: a face inside it, as a document's portrait lies, the largest
    /// there; a second inside counts only at a comparable size, so a
    /// document's smaller ghost portrait does not, and faces outside it do
    /// not count. Drawn as large as fits the frame.
    record rect-shape {
        aspect: f32,
    }

    /// Read: the face filling it, the only face in the picture. As wide for
    /// its height as `enclavid:host-capture/constants.oval-aspect` says.
    record oval-shape {
        width: f32,
    }

    variant shape {
        rect(rect-shape),
        oval(oval-shape),
    }

    /// Read as its shape is.
    record shape-guide {
        shape: shape,
    }

    /// Read: the face filling the oval drawn for it, as an `oval-shape` is.
    record face-guide {
        width: f32,
    }

    variant guide {
        shape(shape-guide),
        face(face-guide),
    }

    /// Whether the face followed the guide, or how it did not.
    enum status {
        followed,
        /// No face — for a rect, none inside it — or a picture that does not
        /// decode.
        no-face,
        /// A second face; for a rect, a second inside it of a comparable
        /// size.
        extra-face,
        /// The face does not fill the oval: too small, too large, or off its
        /// centre.
        off-oval,
    }

    record reading {
        /// The face read: the most prominent; for a rect, the most prominent
        /// inside it.
        face: option<face>,
        status: status,
    }

    /// Whether the face in `image` follows `guide`.
    read: func(image: borrow<image>, guide: guide) -> reading;
}

/// The face in frames of a video, read against the guides held in them.
interface video {
    use enclavid:host/media@0.1.0.{video};
    use enclavid:vision/types@0.1.0.{frame-face};
    use photo.{shape};

    /// Read as its shape is in a photo, through `hold-ms`, forgiving breaks as
    /// this reader does by itself; the head is not read.
    record shape-guide {
        shape: shape,
        hold-ms: u16,
    }

    /// Read: the face filling the oval drawn for it, through `hold-ms`,
    /// forgiving breaks up to `grace-ms`.
    record face-guide {
        width: f32,
        hold-ms: u16,
        grace-ms: u16,
    }

    /// Read: the head turned at least `degrees` to its side, from how it
    /// looked when the face last filled the oval of a `face-guide` or
    /// `face-flashes-guide` — straight on by the keypoints where it never did
    /// — through `hold-ms`, forgiving breaks up to `grace-ms`.
    record head-turn-guide {
        degrees: s8,
        hold-ms: u16,
        grace-ms: u16,
    }

    record color {
        red: u8,
        green: u8,
        blue: u8,
    }

    /// Read as a `face-guide` is, through all its flashes.
    record face-flashes-guide {
        width: f32,
        colors: list<color>,
        flash-ms: u16,
        grace-ms: u16,
    }

    variant guide {
        shape(shape-guide),
        face(face-guide),
        head-turn(head-turn-guide),
        face-flashes(face-flashes-guide),
    }

    /// Where a guide was held, by frame index into the video: the platform's
    /// `frame-range`, copied.
    record frame-range {
        guide: guide,
        first: u32,
        last: u32,
    }

    /// Whether the face followed a guide through its frames, or how it did
    /// not.
    enum status {
        followed,
        /// A frame holds no face — for a rect, none inside it — or does not
        /// decode.
        no-face,
        /// A frame holds a second face; for a rect, a second inside it of a
        /// comparable size.
        extra-face,
        /// The face does not fill the oval: too small, too large, or off its
        /// centre.
        off-oval,
        /// The head did not turn as far as the guide asks, or turned the
        /// other way.
        wrong-turn,
        /// The frames span less than the guide is held for, or run past the
        /// video — a video that does not decode has none.
        short-hold,
    }

    /// The face in one guide's frames.
    record reading {
        /// The guide, as given.
        guide: guide,
        /// The face in each frame where one is found, as `photo` finds it.
        faces: list<frame-face>,
        status: status,
    }

    /// One reading for each of `ranges`, in their order.
    read: func(video: borrow<video>, ranges: list<frame-range>) -> list<reading>;
}

world face-detect {
    // Reads the host's `image`s and `video`s and produces `face` geometry; the
    // ovals of the guides are as wide for their height as the host says. No
    // embedded catalog.
    import enclavid:host/media@0.1.0;
    import enclavid:host-capture/constants@0.1.0;
    import enclavid:vision/types@0.1.0;
    export detect;
    export pose;
    export photo;
    export video;
}
